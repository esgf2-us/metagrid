should create a default service:
  1: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app.kubernetes.io/component: frontend
        app.kubernetes.io/instance: metagrid
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: metagrid
        app.kubernetes.io/version: v1.0.0
        helm.sh/chart: metagrid-v1.0.0
      name: metagrid-frontend
    spec:
      ports:
        - name: http
          port: 8080
          protocol: TCP
          targetPort: http
      selector:
        app.kubernetes.io/component: frontend
        app.kubernetes.io/instance: metagrid
        app.kubernetes.io/name: metagrid
      type: ClusterIP
