should have a deployment:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/component: backend
        app.kubernetes.io/instance: metagrid
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: metagrid
        app.kubernetes.io/version: v1.0.0
        helm.sh/chart: metagrid-v1.0.0
      name: metagrid-backend
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/component: backend
          app.kubernetes.io/instance: metagrid
          app.kubernetes.io/name: metagrid
      template:
        metadata:
          annotations:
            checksum/config: b41be586b96f795a0eba06a9bb0badafbbbe965369da2d8573e7df4e7dcc5262
          labels:
            app.kubernetes.io/component: backend
            app.kubernetes.io/instance: metagrid
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: metagrid
            app.kubernetes.io/version: v1.0.0
            helm.sh/chart: metagrid-v1.0.0
        spec:
          containers:
            - env:
                - name: THIS_POD_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.podIP
                - name: DJANGO_ALLOWED_HOSTS
                  value: '["localhost","$(THIS_POD_IP)"]'
              envFrom:
                - secretRef:
                    name: metagrid
                - configMapRef:
                    name: metagrid
              image: ghcr.io/esgf2-us/metagrid-backend:v1.0.0
              imagePullPolicy: IfNotPresent
              livenessProbe:
                failureThreshold: 3
                httpGet:
                  path: /liveness
                  port: http
                initialDelaySeconds: 0
                periodSeconds: 30
                successThreshold: 1
                timeoutSeconds: 5
              name: backend
              ports:
                - containerPort: 5000
                  name: http
                  protocol: TCP
              readinessProbe:
                failureThreshold: 6
                httpGet:
                  path: /readiness
                  port: http
                initialDelaySeconds: 0
                periodSeconds: 10
                successThreshold: 1
                timeoutSeconds: 5
              resources: {}
              securityContext: {}
              startupProbe:
                failureThreshold: 18
                httpGet:
                  path: /readiness
                  port: http
                initialDelaySeconds: 0
                periodSeconds: 10
                successThreshold: 1
                timeoutSeconds: 5
          securityContext: {}
          serviceAccountName: metagrid-backend
